# Meta Facebook Login (server-side only)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_TOKEN_ENCRYPTION_KEY=
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/facebook/callback
